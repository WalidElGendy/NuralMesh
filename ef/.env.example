# EF · Earth Intelligence Platform — ef.meshnet.co
# Copy to .env.local for dev. In Vercel, set these as project env vars.

# Supabase (the shared MeshNet project: neuralmesh-beta)
VITE_SUPABASE_URL=https://czphnagkzvkemgtkliew.supabase.co
VITE_SUPABASE_ANON_KEY=

# MeshNet orchestrator — this is what makes inference sovereign.
# Prompts route through the 7-stage pipeline to Saudi GPU provider nodes.
VITE_MESH_API_BASE=https://api.beta.meshnet.co

# Sentinel Hub instance ID — unlocks the NDVI / SAR / thermal layers.
# Free tier: https://apps.sentinel-hub.com/dashboard/
# Leave blank and the app falls back to the keyless layers (OSM, Sentinel-2 cloudless, Esri, terrain).
VITE_SENTINEL_HUB_INSTANCE_ID=
